# Where does each witness put mezzoforte, in what unit, and on what evidence?
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wt: <https://w3id.org/welte-t100/>
PREFIX property: <https://w3id.org/welte-t100/property/>
PREFIX concept: <https://w3id.org/welte-t100/concept/>
PREFIX logic: <https://w3id.org/welte-t100/logic/>
PREFIX crmsci: <http://www.cidoc-crm.org/extensions/crmsci/>

SELECT ?quantity ?holder ?value ?unit ?holds ?locator
WHERE {
  # Every narrower term under the two roots, so that a witness measuring mezzoforte on a
  # scale nobody has used yet is picked up without editing the query.
  VALUES ?root { property:mf-position-on-scale property:hook-arrest-level }
  ?type crm:P46i_forms_part_of* ?root ;
        rdfs:label ?quantity .
  ?proposition crminf:J32_has_property_type ?type ;
               crminf:J31_has_range ?dimension .
  ?dimension crm:P90_has_value ?value ;
             crm:P91_has_unit/rdfs:label ?unit .
  FILTER (LANG(?unit) = "en")
  ?belief crminf:J4_that ?proposition ;
          crminf:J5_holds_to_be ?holds .
  ?argument crminf:J2_concluded_that ?belief ;
            crm:P14_carried_out_by/rdfs:label ?holder .
  ?passage crm:P70_documents ?argument ;
           wt:locator ?locator .
}
ORDER BY ?quantity ?value
