# Which of the project's own numbers rest on nothing but a fit?
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wt: <https://w3id.org/welte-t100/>
PREFIX property: <https://w3id.org/welte-t100/property/>
PREFIX concept: <https://w3id.org/welte-t100/concept/>
PREFIX logic: <https://w3id.org/welte-t100/logic/>
PREFIX crmsci: <http://www.cidoc-crm.org/extensions/crmsci/>

SELECT ?claim ?logic ?locator
WHERE {
  VALUES ?applied { logic:differential-evolution-then-simplex logic:ablation-refit }
  ?inference a crminf:I5_Inference_Making ;
             crminf:J3_applied ?applied ;
             crminf:J2_concluded_that ?belief ;
             rdfs:label ?claim .
  ?applied rdfs:label ?logic .
  ?passage crm:P70_documents ?inference ; wt:locator ?locator .
  FILTER NOT EXISTS {
    ?inference crminf:J1_used_as_premise ?premise .
    ?other crminf:J2_concluded_that ?premise .
    ?other a crmsci:S21_Measurement .
  }
}
ORDER BY ?claim
