# What is known about roll 3309's own history, and on whose word
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wt: <https://w3id.org/welte-t100/>
PREFIX event: <https://w3id.org/welte-t100/event/>
PREFIX thing: <https://w3id.org/welte-t100/thing/>

SELECT ?event ?relation ?value ?holds ?holder ?locator
WHERE {
  VALUES ?subject {
    event:performance-backhaus-1920 event:production-3309
    event:digitisation-3309 thing:roll-3309
  }
  ?subject rdfs:label ?event .
  ?proposition crminf:J30_has_domain ?subject ;
               crminf:J32_has_property_type/rdfs:label ?relation ;
               crminf:J31_has_range ?target .
  ?target rdfs:label ?value .
  ?belief crminf:J4_that ?proposition ; crminf:J5_holds_to_be ?holds .
  ?argument crminf:J2_concluded_that ?belief ;
            crm:P14_carried_out_by/rdfs:label ?holder .
  ?passage crm:P70_documents ?argument ; wt:locator ?locator .
  # Prefer the English label, but do not drop an entity that has only a German one.
  FILTER (LANG(?event) = "en" || NOT EXISTS { ?subject rdfs:label ?en_e FILTER (LANG(?en_e) = "en") })
  # Prefer the English label, but do not drop an entity that has only a German one.
  FILTER (LANG(?value) = "en" || NOT EXISTS { ?target rdfs:label ?en_v FILTER (LANG(?en_v) = "en") })
}
ORDER BY ?event ?relation
