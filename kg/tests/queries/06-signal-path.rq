# Every link in the T-100 signal path, and the page it is read from
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wt: <https://w3id.org/welte-t100/>
PREFIX property: <https://w3id.org/welte-t100/property/>

SELECT ?from ?link ?to ?locator
WHERE {
  VALUES ?type {
    property:supplies-vacuum-to property:supplies-atmosphere-to
    property:evacuates property:admits-air-to property:actuates
    property:opens-throttle property:triggered-by-opening
    property:holds-state-latched property:releases-latch
  }
  ?proposition crminf:J30_has_domain ?subject ;
               crminf:J32_has_property_type ?type ;
               crminf:J31_has_range ?object .
  ?subject rdfs:label ?from .
  ?object rdfs:label ?to .
  ?type rdfs:label ?link .
  # Prefer the English label, but do not drop an entity that has only a German one.
  FILTER (LANG(?from) = "en" || NOT EXISTS { ?subject rdfs:label ?en_f FILTER (LANG(?en_f) = "en") })
  # Prefer the English label, but do not drop an entity that has only a German one.
  FILTER (LANG(?to) = "en" || NOT EXISTS { ?object rdfs:label ?en_t FILTER (LANG(?en_t) = "en") })
  ?belief crminf:J4_that ?proposition .
  ?argument crminf:J2_concluded_that ?belief .
  ?passage crm:P70_documents ?argument ; wt:locator ?locator .
}
ORDER BY ?link ?from
