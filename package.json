{
  "name": "welte-t100-emulator",
  "version": "0.2.0",
  "type": "module",
  "description": "The expression mechanism of a Welte-Mignon T-100: the take-up spool, the nuancing bellows and the pedals, fitted against the hand-drawn Nuancierungslinien of roll 3309.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pfefferniels/welte-t100.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "eval": "node src/cli/evaluate.ts",
    "fit": "node src/cli/fit.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
